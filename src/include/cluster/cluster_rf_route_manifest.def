/*-------------------------------------------------------------------------
 *
 * cluster_rf_route_manifest.def
 * Sole generated opcode-route authority.
 *
 * Define RF_OPCODE_ROUTE_ROW(rmid, info_binding, legal_flags, owner,
 *                            block_policy, codec, active, diagnostic_name),
 * RF_OPCODE_ROUTE_BASE(), RF_OPCODE_ROUTE_COMBINED(),
 * RF_OPCODE_ROUTE_GENERIC and RF_OPCODE_ROUTE_INACTIVE_STOP07 before include.
 * Rows stay sorted by numeric (rmid, info).  The inactive STOP07 row remains
 * part of completeness/collision proof but is not admitted by lookup.
 *
 * Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group
 * Portions Copyright (c) 1994, Regents of the University of California
 * Portions Copyright (c) 2026, pgrac contributors
 *
 * Author: SqlRush <sqlrush@gmail.com>
 *
 * IDENTIFICATION
 *    src/include/cluster/cluster_rf_route_manifest.def
 *
 *-------------------------------------------------------------------------
 */

